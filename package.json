{
  "name": "pdfgpu",
  "version": "0.1.13",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "apps/*/src/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "npm run verify:release-contract && turbo run build",
    "start": "node apps/pdfgpu/src/server/dist/index.js",
    "deploy": "node ./scripts/deploy.mjs",
    "test:libs": "npm run verify:release-contract && npm run test --workspaces --if-present",
    "verify:release-contract": "node scripts/verify-release-contract.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.46.1",
    "@types/node": "^22.16.7",
    "turbo": "^1.9.5",
    "typescript": "^5.9.3"
  }
}
