{
  "name": "pdfgpu",
  "version": "0.1.4",
  "private": true,
  "workspaces": [
    "apps/**",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm run verify:release-contract && turbo run build",
    "start": "node apps/pdfgpu/src/server/dist/index.js",
    "deploy": "node ./scripts/deploy.mjs",
    "test:libs": "pnpm run verify:release-contract && pnpm --recursive run test",
    "verify:release-contract": "node scripts/verify-release-contract.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.46.1",
    "@types/node": "^22.16.7",
    "turbo": "^1.9.5",
    "typescript": "^5.9.3"
  }
}
